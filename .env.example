# ==========================================
# Configuração de Ambiente (Template)
# Copie este arquivo para .env e preencha com valores seguros
# NUNCA envie o arquivo .env real para o GitHub!
# ==========================================

# Chave secreta de sessão Flask (gere uma chave forte aleatória com: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=substitua_por_uma_chave_secreta_aleatoria_longa_e_forte

# Modo de execução ('development' para debug local ou 'production' para servidor em nuvem)
FLASK_ENV=production
DEBUG=False

# Usuário e senha padrão para autenticação inicial (definidos de forma segura via ambiente)
ADMIN_USERNAME=admin
# Senha padrão recomendada para primeiro acesso (será convertida em hash seguro no backend)
ADMIN_PASSWORD=SenhaSegura@2026!ProjetoAplicado

# Porta de execução da aplicação (Gunicorn ou execução direta)
PORT=5000
HOST=0.0.0.0

# Configuração de cookies seguros (ativar True quando estiver com HTTPS/Certbot ativo)
COOKIE_SECURE=True
